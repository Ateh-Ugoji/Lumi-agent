# Postgres, asyncpg driver: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=

# Post for Me API token (account connect, post/metric fetch)
PFM_JWT_TOKEN=

# Xpoz access key (social listening — optional until that integration lands)
XPOZ_API_KEY=

# LLM providers, Groq is tried first with OpenRouter as fallback
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Jev / TypeSafe AI judge (enforcement checks on repurposed captions)
TYPESAFE_API_KEY=

# neatlogs observability
NEATLOGS_API_KEY=

# App secret, used for signing/auth
SECRET_KEY=

# Chroma Cloud (agentic storage). Leave blank to use local PersistentClient at .chroma/
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_PATH=.chroma

# OpenLux relay (optional primary LLM provider, tried before Groq/OpenRouter when set)
OPENLUX_API_KEY=
OPENLUX_MODEL=qwen3.8-27b

# Google OAuth for the MCP connectors (Google Drive + Docs).
# Create a "Web application" OAuth client in Google Cloud (consent screen + the
# "Use this client for an AI-powered agent" option), register the redirect URI,
# and paste the client id/secret here. Tokens are stored in the DB, never here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/mcp/google/callback

# MCP master switch (true/false). Per-connector toggles: MCP_GDRIVE_ENABLED, MCP_GDOCS_ENABLED
MCP_ENABLED=true
