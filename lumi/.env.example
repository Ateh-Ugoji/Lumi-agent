# Lumi: variables de entorno. Copia este archivo a lumi/.env y pega los valores.
# lumi/.env nunca se sube a git. Aquí no va ningún valor real.
# Marca: [OBLIGATORIA] sin ella la app no arranca (el error lista todas las que faltan).
#        [opcional]    sin ella la función se apaga y el arranque avisa con un WARNING.
# Guía completa: lumi/docs/API_KEYS.md

# ---------------------------------------------------------------- Núcleo
# [OBLIGATORIA] PostgreSQL (único motor, sin SQLite). Formato Django: postgresql://usuario:clave@host:5432/lumi
# En local: `docker compose up -d db` o `uv run python scripts/dev_postgres.py` (imprime la URL).
# Con Docker Compose: postgresql://lumi:lumi_dev@localhost:5432/lumi
DATABASE_URL=

# [OBLIGATORIA] Firma de Django. Genera una: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# [OBLIGATORIA] Clave Fernet que cifra en Postgres los tokens OAuth de redes y de Google.
# Genera una: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# [opcional] Clave Fernet anterior, solo mientras se rota TOKEN_ENCRYPTION_KEY. Déjala vacía el resto del tiempo.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# [opcional] Ajustes de Django. Los valores de ejemplo sirven para desarrollo local.
# DJANGO_SETTINGS_MODULE=config.settings.dev
# DEBUG=true
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
# CSRF_TRUSTED_ORIGINS=
# AUTH_TOKEN_TTL_DAYS=30
# LOG_LEVEL=INFO
# [opcional] Ruta de otro archivo de entorno en lugar de lumi/.env (las variables reales del proceso ganan siempre).
# LUMI_ENV_FILE=
# [opcional, solo producción] Redirige a https y HSTS. Detrás de un proxy que reenvía X-Forwarded-Proto.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=0

# [opcional] Redis para Celery y para el estado compartido (OAuth, escrituras pendientes de MCP).
# Sin REDIS_URL se usa memoria del proceso: solo válido con un único worker y para desarrollo.
# REDIS_URL=redis://localhost:6379/0

# [opcional] Origen de la base legada al importar datos (T8): sqlite:////ruta/lumi.db o postgresql://...
# LEGACY_DATABASE_URL=

# ---------------------------------------------------------------- URLs públicas
# [opcional] URL pública del backend (para los redirect de OAuth). Local: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
# [opcional] URL del frontend React, a donde vuelven los callbacks de OAuth. Local: http://localhost:3010
FRONTEND_URL=http://localhost:3010

# ---------------------------------------------------------------- Modelos de lenguaje
# [OBLIGATORIA] Groq es el proveedor principal (modelos y voz a texto).
GROQ_API_KEY=
# [opcional] OpenRouter es el respaldo cuando Groq falla o se agota (check_keys lo trata como opcional).
OPENROUTER_API_KEY=
# [opcional] Relay OpenLux, se prueba antes que Groq y OpenRouter si hay key.
OPENLUX_API_KEY=
OPENLUX_MODEL=qwen3.8-27b
# [opcional, con valor por defecto] Modelos. Se validan contra el catálogo real con `manage.py check_keys`.
# Nota: qwen/qwen3.8-27b viene del código legado y no está verificado contra el catálogo de Groq.
# GROQ_MODEL_LARGE=openai/gpt-oss-120b
# GROQ_MODEL_SMALL=openai/gpt-oss-20b
# GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# WHISPER_MODEL=whisper-large-v3-turbo
# [opcional, con valor por defecto] Segundos que un proveedor caído se aparta (300 y tope de 900) y espera máxima de una llamada (60).
# PROVIDER_COOLDOWN_SECONDS=300
# PROVIDER_COOLDOWN_MAX_SECONDS=900
# LLM_TIMEOUT_SECONDS=60
# [opcional] Juez Jev (TypeSafe AI). Sin ella se usa un modelo pequeño de Groq o reglas.
TYPESAFE_API_KEY=
# [opcional] Trazas con neatlogs.
NEATLOGS_API_KEY=

# ---------------------------------------------------------------- Vectores (ChromaDB)
# [opcional] Con CHROMA_API_KEY vacío se usa un Chroma local en CHROMA_PATH. Solo guarda vectores.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_PATH=.chroma

# ---------------------------------------------------------------- Datos de redes sociales
# [opcional] Post for Me: conectar cuentas, traer posts y métricas, publicar.
PFM_JWT_TOKEN=

# [opcional] Xpoz: escucha social y posts de competidores. Cada consulta gasta créditos.
XPOZ_API_KEY=
XPOZ_API_KEY_2=
# Interruptor de las llamadas reales a Xpoz. Con false no se gasta ningún crédito.
XPOZ_LIVE_ENABLED=false
# Tope de créditos de Xpoz por ejecución. Al llegar se corta con BudgetExceeded.
# 12 es lo que cuesta una búsqueda de usuarios en Instagram; con menos, esa búsqueda no cabe.
XPOZ_RUN_CREDIT_BUDGET=12
# [opcional] Tope propio de una red. Sin la variable, esa red usa XPOZ_RUN_CREDIT_BUDGET.
# XPOZ_RUN_CREDIT_BUDGET_X=
# XPOZ_RUN_CREDIT_BUDGET_INSTAGRAM=
# XPOZ_RUN_CREDIT_BUDGET_TIKTOK=
# XPOZ_RUN_CREDIT_BUDGET_REDDIT=
# Minutos que vale la caché de búsqueda de handles.
HANDLE_CACHE_TTL_MINUTES=60

# [opcional] Meta (Facebook). En modo Development solo funcionan cuentas con rol en la app.
META_APP_ID=
META_APP_SECRET=
# Versión de Graph API.
META_GRAPH_VERSION=v26.0

# [opcional] LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Valor de la cabecera Linkedin-Version (AAAAMM).
LINKEDIN_API_VERSION=202609

# [opcional] X (OAuth 2.0 con PKCE). La publicación real exige X_LIVE_ENABLED=true.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_LIVE_ENABLED=false

# ---------------------------------------------------------------- Video (análisis multimodal)
# [opcional] Sin VIDEO_PROVIDER la función está apagada. Los nombres se confirman al elegir proveedor.
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_MODEL=gemini-3.5-flash-lite
VIDEO_MAX_MB=20
VIDEO_MAX_PER_RUN=5

# ---------------------------------------------------------------- Google Drive y Docs (MCP)
# [opcional] Cliente OAuth "Aplicación web" de Google Cloud. Los tokens van cifrados en la base, no aquí.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback
# Interruptor general de MCP y por conector.
MCP_ENABLED=true
# MCP_GDRIVE_ENABLED=true
# MCP_GDOCS_ENABLED=true

# ---------------------------------------------------------------- Demo
# [opcional] Para `manage.py seed_demo`: crea un usuario y un perfil genéricos (T3).
# DEMO_EMAIL=
# DEMO_PASSWORD=
# DEMO_PLATFORM=x
# DEMO_HANDLE=
