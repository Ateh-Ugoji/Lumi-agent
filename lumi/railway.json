{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "DJANGO_SETTINGS_MODULE=config.settings.prod uv run python manage.py collectstatic --noinput"
  },
  "deploy": {
    "preDeployCommand": [
      "uv run python manage.py migrate --noinput"
    ],
    "startCommand": "uv run uvicorn config.asgi:application --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE"
  }
}
